# Copy this file to .env and fill in real values for local development.
# Never commit an actual .env file — it's gitignored on purpose.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lms_dev?schema=public"

# Generate a real random secret for anything beyond local dev, e.g.: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1h"

PORT=3000

# Optional. Leave unset for local dev — the API accepts requests from any origin, which
# is fine on localhost. In production, set this to your frontend's exact origin(s)
# (comma-separated if more than one, e.g. "https://barotech.com,https://www.barotech.com")
# so the API only answers browser requests from your real site.
# CORS_ORIGIN="https://barotech.com"

# Optional. Leave unset for local dev — EmailModule falls back to a console-log stub
# (see src/email/email.service.ts) with no real credentials needed. Set both to switch
# to real delivery via Resend (https://resend.com — free tier is 3,000 emails/month).
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM_ADDRESS="BaroTech <noreply@yourdomain>"

# Optional — used only by prisma/seed.ts to set the initial Super Admin account.
# Defaults to admin@university.local / ChangeMe123! if not set.
# SEED_SUPER_ADMIN_EMAIL="admin@university.local"
# SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"

# Optional. Leave all four unset for local dev — StorageService logs a warning and file
# upload/download endpoints return 503 rather than failing to boot. Set all four to
# enable course-material and assignment file attachments via Cloudflare R2 (an
# S3-compatible object store — see src/storage/storage.service.ts). Get these from the
# Cloudflare dashboard: R2 -> Manage R2 API Tokens -> Create API Token.
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET_NAME="barotech-uploads"
